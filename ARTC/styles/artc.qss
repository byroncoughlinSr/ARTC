/*
 * ARTC application stylesheet.
 *
 * Palette
 *   canvas   #F4F6F9   page background
 *   card     #FFFFFF   raised panel
 *   border   #DCE3EC   hairlines
 *   ink      #16233A   primary text
 *   muted    #64748B   secondary text
 *   accent   #1E3A5F   primary action
 *   error    #C0392B   validation failures
 *
 * Qt's stylesheet engine supports no variables and no box-shadow; the card
 * shadow is applied in code by UiTheme::applyCardShadow().
 */

QWidget {
    font-family: "Segoe UI", "Inter", "Noto Sans", "DejaVu Sans", sans-serif;
    font-size: 14px;
    color: #16233A;
}

QWidget#screen {
    background-color: #F4F6F9;
}

QFrame#card {
    background-color: #FFFFFF;
    border: 1px solid #DCE3EC;
    border-radius: 12px;
}

/* ---- Typography ---- */

QLabel#monogram {
    background-color: #1E3A5F;
    color: #FFFFFF;
    border-radius: 38px;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel#appTitle {
    font-size: 30px;
    font-weight: 600;
    color: #16233A;
}

QLabel#screenTitle {
    font-size: 22px;
    font-weight: 600;
    color: #16233A;
}

QLabel#subtitle {
    font-size: 15px;
    color: #1E3A5F;
    font-weight: 500;
}

QLabel#bodyText,
QLabel#footerText {
    color: #64748B;
}

QLabel#footerText {
    font-size: 12px;
}

QLabel#fieldLabel {
    font-size: 13px;
    font-weight: 500;
    color: #334155;
}

QLabel#errorLabel {
    color: #C0392B;
    font-size: 13px;
}

QLabel#noticeLabel {
    background-color: #FFF7E6;
    border: 1px solid #F0D9A8;
    border-radius: 6px;
    color: #7A5A16;
    font-size: 13px;
    padding: 10px 12px;
}

QFrame#divider {
    background-color: #E7ECF3;
    border: none;
    max-height: 1px;
    min-height: 1px;
}

/* ---- Inputs ---- */

QLineEdit,
QDateEdit {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 9px 11px;
    selection-background-color: #2C5282;
    selection-color: #FFFFFF;
}

QLineEdit:hover,
QDateEdit:hover {
    border-color: #A9B7C9;
}

QLineEdit:focus,
QDateEdit:focus {
    border-color: #2C5282;
}

QLineEdit[invalid="true"],
QDateEdit[invalid="true"] {
    border-color: #C0392B;
}

/*
 * QDateEdit's calendar button is deliberately left unstyled. Overriding
 * ::drop-down without supplying an arrow image erases the arrow altogether,
 * which leaves the date picker invisible and unreachable.
 */

/* ---- Buttons ---- */

QPushButton#primaryButton {
    background-color: #1E3A5F;
    color: #FFFFFF;
    border: 1px solid #1E3A5F;
    border-radius: 6px;
    padding: 11px 18px;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #2C5282;
    border-color: #2C5282;
}

QPushButton#primaryButton:pressed {
    background-color: #16304F;
    border-color: #16304F;
}

QPushButton#primaryButton:disabled {
    background-color: #A8B4C4;
    border-color: #A8B4C4;
}

QPushButton#secondaryButton {
    background-color: #FFFFFF;
    color: #1E3A5F;
    border: 1px solid #1E3A5F;
    border-radius: 6px;
    padding: 11px 18px;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#secondaryButton:hover {
    background-color: #EEF3F9;
}

QPushButton#secondaryButton:pressed {
    background-color: #DFE8F3;
}

QPushButton#linkButton {
    background-color: transparent;
    border: none;
    color: #2C5282;
    font-size: 13px;
    padding: 4px 2px;
    text-align: left;
}

QPushButton#linkButton:hover {
    color: #16304F;
    text-decoration: underline;
}

/* ---- Chrome ---- */

QMenuBar,
QToolBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #DCE3EC;
}

QMenuBar::item:selected {
    background-color: #EEF3F9;
}

QStatusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #DCE3EC;
    color: #64748B;
}
